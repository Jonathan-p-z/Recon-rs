# recon-rs per-target deployment environment.
#
# One of these lives at ~/.config/recon-rs/targets/<name>.env per target (e.g.
# vfc.env, vans.env), loaded by recon-rs@<name>.service via
# EnvironmentFile=%h/.config/recon-rs/targets/%i.env — %i is the <name> after the @
# (recon-rs@vfc.service reads targets/vfc.env, recon-rs@vans.service reads
# targets/vans.env, etc). deploy/install.sh generates the initial set of these from
# this template for the known VF Corporation VDP sub-targets (substituting __TARGET__
# and __PROGRAM_CONFIG__ below); see deploy/README.md for adding a target by hand.
#
# This is loaded by systemd's EnvironmentFile= directive (see recon-rs@.service),
# which is a separate mechanism from recon-db's dotenvy-based .env loading used in
# development — this file is NOT read by `cargo run`, and the repository's own
# .env/.env.example are NOT read by the deployed service. Keep the two separate on
# purpose: a production target/credentials should never depend on whatever happens to
# be sitting in a developer's working tree.
#
# Before pointing this at a real program: re-read that program's CURRENT scope and
# rules (see deploy/README.md's reminder) — do not assume this file is still accurate
# just because it was correct when last edited.

# Target domain to scan. Must be authorized under PROGRAM_CONFIG's [scope] —
# recon-cli refuses to scan otherwise, with a clear error, not just a warning.
TARGET=__TARGET__

# Path to the program config bundling [scope] + [prober] overrides for this engagement.
# Use an absolute path: systemd's WorkingDirectory for this service is the deployed
# config directory, not your git checkout. All VF Corporation VDP sub-targets share
# the SAME file here (its [scope] already lists every sub-brand domain) — see
# config/programs/vfc-vdp.toml.
PROGRAM_CONFIG=__PROGRAM_CONFIG__

# Path to a seed file of already-known subdomains for THIS target (one FQDN per line).
# Absolute path recommended, same reasoning as PROGRAM_CONFIG. Different per target —
# don't point two targets/*.env files at the same seed file.
SEED_FILE=/home/CHANGE_ME/.config/recon-rs/seed-__NAME__.txt

# PostgreSQL connection string. Every targets/*.env for this deployment should have the
# SAME value here — one database, one `scans`/`scan_results` schema, rows
# differentiated by `target_domain`, not one database per target. Never commit a real
# value.
DATABASE_URL=postgres://user:password@localhost:5432/recon_rs
